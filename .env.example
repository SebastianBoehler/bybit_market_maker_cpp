# Bybit Market Maker example configuration
# Core trading settings
# SUIUSDT is the default low-notional test symbol; override as needed
BYBIT_SYMBOL=SUIUSDT
BYBIT_RUN_LIVE=0
BYBIT_BUDGET_USD=50
# Minimum spread floor in bps (0.2 = 0.002%)
BYBIT_MIN_SPREAD_BPS=0.2
# Multiply live spread by this factor (1.0 = as-is)
BYBIT_SPREAD_FACTOR=1.0
# Ladder levels per side
BYBIT_LADDER_LEVELS=3
# Max net inventory in contract/base-asset quantity for linear perps
BYBIT_MAX_NET_QTY=100
# Required and positive in live mode (quote notional across positions and opening orders)
BYBIT_GROSS_NOTIONAL_CAP=100
# Additional safety buffer beyond fee-aware take-profit break-even, in bps
BYBIT_TP_SPREAD_BPS=0.5
# Optional stop-loss trigger in bps from entry (set -1 to disable)
BYBIT_STOP_LOSS_BPS=-1

# Credentials
# Set your API key/secret for live trading
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Endpoints
BYBIT_WS_PUBLIC_URL=wss://stream.bybit.com/v5/public/linear
BYBIT_WS_PRIVATE_URL=wss://stream.bybit.com/v5/private
BYBIT_BASE_URL=https://api.bybit.com

# Decisions wake on fresh websocket state; disconnects require a clean restart.
